<?xml version="1.0" ?>
<robot name="simple_arm">
  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <link name="upper_arm">
    <visual>
      <geometry>
         <cylinder length="0.5" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_upper" type="fixed">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Forearm and Elbow -->
  <link name="forearm">
    <visual>
      <geometry>
         <cylinder length="0.4" radius="0.035"/>
      </geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1415" upper="3.1415" effort="100" velocity="10"/>
  </joint>

  <!-- Hand and Wrist -->
  <link name="hand">
    <visual>
      <geometry>
         <box size="0.05 0.1 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_wrist" type="revolute">
    <parent link="forearm"/>
    <child link="hand"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1415" upper="3.1415" effort="100" velocity="10"/>
  </joint>

  <!-- Grippers (Aperture) -->
  <link name="finger_left">
    <visual>
      <geometry>
         <box size="0.02 0.02 0.1"/>
      </geometry>
      <origin xyz="0 0.0 0.05" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_finger_left" type="prismatic">
    <parent link="hand"/>
    <child link="finger_left"/>
    <origin xyz="0 0.025 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="100" velocity="10"/>
  </joint>

  <link name="finger_right">
    <visual>
      <geometry>
         <box size="0.02 0.02 0.1"/>
      </geometry>
      <origin xyz="0 0.0 0.05" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_finger_right" type="prismatic">
    <parent link="hand"/>
    <child link="finger_right"/>
    <origin xyz="0 -0.025 0.08" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.04" effort="100" velocity="10"/>
  </joint>

</robot>
